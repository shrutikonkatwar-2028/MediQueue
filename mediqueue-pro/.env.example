# --- Server ---
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
HOSPITAL_NAME=MediQueue Hospital
# Used inside QR codes. For phone scanning use your PC's LAN IP, e.g. http://192.168.1.10:3000
BASE_URL=

# --- Database ---
# sqlite = no setup, data is stored in data/mediqueue.db (good for demo, college project, small clinic)
# mysql  = separate MySQL / XAMPP server (better for many users). Then also fill the DB_* lines below.
DB_TYPE=sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mediqueue
